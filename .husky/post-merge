# Rebuild index.js after merging to ensure it matches the merged source code
# This prevents stale builds and merge conflict residue

get_cmd() {
  local cmd="$1"
  case "$(uname)" in
  *CYGWIN* | *MINGW* | *MSYS*)
    echo "${cmd}.cmd"
    ;;
  *)
    echo "$cmd"
    ;;
  esac
}

echo "🔄 Rebuilding index.js after merge..."
$(get_cmd npm) run build
git add scripts/index.js 2>/dev/null || true
echo "✅ index.js rebuilt successfully"

