# EditorConfig: https://editorconfig.org
root = true

[*]
# Use linux line endings
end_of_line = lf
# Use 2 spaces for indentation (matches Prettier tabWidth: 2, useTabs: false)
indent_style = space
indent_size = 2
# General formatting
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Windows files
[*.bat]
end_of_line = crlf